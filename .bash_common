#!/bin/bash

#------------------------------------------------------------
#  PATH
#------------------------------------------------------------
#PATH="/usr/local/opt/php@7.4/bin:$PATH"
#PATH="/usr/local/opt/php@7.4/sbin:$PATH"
PATH="$HOME/.symfony/bin:$PATH"
PATH=$HOME/.local/bin:$PATH
PATH=~/ghq/github.com/clood-jp/bin:"$PATH"
PATH=~/bin:"$PATH"
PATH=~/bin/vendor:"$PATH"
PATH=~/go/bin:"$PATH"
PATH=~/.composer/vendor/bin:"$PATH"
PATH=/usr/local/bin:"$PATH"
PATH=/usr/local/sbin:"$PATH"
PATH=/opt/homebrew/bin:"$PATH"
PATH=/opt/homebrew/bin:"$PATH"
PATH=/usr/local/opt/php@8.0/bin:"$PATH"
PATH=/usr/local/opt/php@8.0/sbin:"$PATH"

# 優先順位高
export PYENV_ROOT=${HOME}/.pyenv
if [ -d "${PYENV_ROOT}" ]; then
    export PATH=${PYENV_ROOT}/bin:$PATH
    eval "$(pyenv init -)"
fi

# 優先順位高
if [ -e "$HOME/.nodenv" ]
then
    export NODENV_ROOT="$HOME/.nodenv"
    export PATH="$NODENV_ROOT/bin:$PATH"
    if command -v nodenv 1>/dev/null 2>&1
    then
        eval "$(nodenv init -)"
    fi
fi

export PATH

#------------------------------------------------------------
#  History
#------------------------------------------------------------
# .bash_profileのみに設定すると、非ログインシェルの場合
# HISTSIZEなどが設定されず、結果として履歴が消去される事故が
# 発生するため.bash_commonで設定している

HISTCONTROL=ignoreboth                              # 空白、重複履歴を保存しない
HISTSIZE=1000000
HISTFILESIZE=10000000
HISTIGNORE=history
HISTTIMEFORMAT='%F %T '

# -u ではメモリ上履歴で上書きになるため、競合が発生する
# -s では都度ファイル追加になるため、競合は発生しない
# PROMPT_COMMAND は、シェル終了時にしか実行されないため、その場合も考慮するとこの設定も必要
shopt -s histappend

# share history
# 複数シェル間で履歴を共有するための関数
function share_history {
  history -a  # append to .bash_history
  history -c  # clear local history
  history -r  # restore from .bash_history
}

# 対話的シェルのときだけ PROMPT_COMMAND を設定
case $- in
  *i*) PROMPT_COMMAND='share_history' ;;
esac


